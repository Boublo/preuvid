# ─────────────────────────────────────────
# Preuvid — variables de l'API en développement local (hors Docker)
# ─────────────────────────────────────────
# Pour la pile Docker, utiliser .env.community.
# Copier vers backend/.env et remplir les secrets avec des valeurs aléatoires :
#   openssl rand -hex 32
# Ce fichier ne contient volontairement aucune valeur utilisable telle quelle :
# l'API refuse de démarrer en production avec un secret vide ou d'exemple.
# ─────────────────────────────────────────

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Base PostgreSQL locale
DATABASE_URL=postgresql://idswyft:MOT_DE_PASSE@localhost:5432/idswyft

# Origines autorisées (séparées par des virgules)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Secrets : 64 caractères hexadécimaux chacun, jamais réutilisés d'un environnement à l'autre
JWT_SECRET=
API_KEY_SECRET=
ENCRYPTION_KEY=
SERVICE_TOKEN=

# Moteur de lecture (conteneur engine)
ENGINE_URL=http://localhost:3002

# Stockage des pièces : local (défaut de la pile), s3 ou supabase
STORAGE_PROVIDER=local
# Chiffrement des fichiers stockés localement (AES-256-GCM sous ENCRYPTION_KEY)
# STORAGE_ENCRYPTION=true   (désactivé par défaut dans le code d’origine ; décision à prendre, voir ROADMAP)
# Pour s3 uniquement :
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

# Limitation de débit
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS_PER_USER=5
RATE_LIMIT_MAX_REQUESTS_PER_DEV=1000

# Webhooks
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=5000

# Durée de conservation des données : [DÉLAI] à fixer par David.
# Tant qu'elle n'est pas renseignée, le code d'origine applique 90 jours.
# DATA_RETENTION_DAYS=

# Bac à sable et vérifications simulées : désactivés par défaut.
# Ne les activer que sur un poste de développement.
SANDBOX_MODE=false
ENABLE_MOCK_VERIFICATION=false
