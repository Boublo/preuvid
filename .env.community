# ─────────────────────────────────────────
# Preuvid — configuration de la pile Docker Compose
# ─────────────────────────────────────────
#   cp .env.community .env
#   puis remplir chaque secret avec une valeur aléatoire propre à cette machine :
#     openssl rand -hex 32
#   ou, sans openssl :
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Aucun secret n'a de valeur par défaut : docker compose refuse de démarrer
# tant qu'une de ces variables est vide, et l'API refuse les valeurs d'exemple.
# Ne jamais versionner le fichier .env.
# ─────────────────────────────────────────

# Mot de passe de la base PostgreSQL
DB_PASSWORD=

# Secrets de l'API (64 caractères hexadécimaux chacun)
JWT_SECRET=
API_KEY_SECRET=
ENCRYPTION_KEY=
SERVICE_TOKEN=

# Port publié par le frontend (défaut : 80).
# En HTTPS, mettre 127.0.0.1:8080 pour que seul Caddy soit exposé.
IDSWYFT_PORT=80

# Mode bac à sable (vérifications simulées) : désactivé en production.
SANDBOX_MODE=false

# ─── HTTPS (optionnel) ───────────────────────
#   1. copier caddy/Caddyfile.acme (ou .manual) vers caddy/Caddyfile
#   2. renseigner DOMAIN et CORS_ORIGINS
#   3. docker compose --profile https up -d
DOMAIN=
# Origines autorisées, séparées par des virgules (ex. https://verif.exemple.fr)
CORS_ORIGINS=

# ─── Passe majeur (clés d'accès) ─────────────
# Domaine et adresse exacte de la page /age, tels que le navigateur les voit (port compris) :
# la création et l'usage du passe sont refusés si l'adresse ne correspond pas.
# Défaut : localhost et http://localhost,https://localhost. Avec IDSWYFT_PORT=127.0.0.1:8088 en local,
# mettre PREUVID_PASSE_ORIGINE=http://localhost:8088. Domaine d'essai : [DOMAINE].
PREUVID_PASSE_DOMAINE=
PREUVID_PASSE_ORIGINE=
